// =============================================================================
// Airport Energy - Firestore security rules
// =============================================================================
// Paste these in: Firebase console -> Firestore Database -> Rules -> Publish.
//
// Model (mirrors the old Supabase RLS setup):
//   fuel_prices/{petrol|diesel}  - public READ, staff WRITE (validated)
//   price_changes/{autoId}       - staff READ + CREATE only; immutable after
// =============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Live fuel prices - anyone may read (the public site polls this),
    // only signed-in staff may write, and only sane values.
    match /fuel_prices/{fuelType} {
      allow read: if true;
      allow write: if request.auth != null
        && fuelType in ['petrol', 'diesel']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 10;
    }

    // Audit log - append-only for signed-in staff. No edits, no deletes,
    // not even by the author, so the trail can't be rewritten.
    match /price_changes/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fuel_type in ['petrol', 'diesel']
        && request.resource.data.new_price is number;
      allow update, delete: if false;
    }

    // Everything else: no access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
