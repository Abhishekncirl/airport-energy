# =============================================================================
# Airport Energy - environment variables
# =============================================================================
# Copy this file to `.env.local` (which is gitignored) and fill in the values
# from your Supabase project: https://supabase.com/dashboard
#
# Both values are PUBLIC by design - they're injected into the JS bundle and
# visible to anyone who views the site. Security is enforced by Supabase
# Row-Level-Security and the `update_fuel_price` RPC, not by hiding the key.
# =============================================================================

# Project URL (Supabase Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# Anon / public key (Supabase Dashboard → Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=
